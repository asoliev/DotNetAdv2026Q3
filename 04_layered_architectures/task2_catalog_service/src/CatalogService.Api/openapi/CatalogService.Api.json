    "/api/v1/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Returns a page of products.",
        "description": "The response includes hypermedia links to navigate available pages.",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "description": "Optional category filter.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "One-based page number.",
