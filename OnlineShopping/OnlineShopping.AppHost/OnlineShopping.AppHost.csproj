<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>online-shopping-apphost</UserSecretsId>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../IdentityService/src/IdentityService.Api/IdentityService.Api.csproj" />
    <ProjectReference Include="../CatalogService/src/CatalogService.Api/CatalogService.Api.csproj" />
    <ProjectReference Include="../CartService/src/CartService.Api/CartService.Api.csproj" />
    <ProjectReference Include="../ApiGateway/src/ApiGateway.Api/ApiGateway.Api.csproj" />
  </ItemGroup>
</Project>