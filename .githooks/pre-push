#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
solution_root="$repo_root/OnlineShopping"
empty_tree=$(git hash-object -t tree /dev/null)
zero_sha=0000000000000000000000000000000000000000
checked_solutions=

# Per-solution file lists (space-separated absolute paths)
files_CartService=
files_CatalogService=
files_IdentityService=

default_remote_ref() {
  git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main
}

first_push_base() {
  local_sha=$1
  remote_ref=$2

  if git rev-parse --verify "$remote_ref" >/dev/null 2>&1; then
    git merge-base "$local_sha" "$remote_ref"
  else
    echo "$empty_tree"
  fi
}

queue_solution() {
  solution=$1
  case " $checked_solutions " in
    *" $solution "*) return ;;
  esac
  checked_solutions="$checked_solutions $solution"
}

add_file_for_solution() {
  key=$1   # CartService | CatalogService | IdentityService
  file=$2
  eval "list=\$files_${key}"
  case " $list " in
    *" $file "*) return ;;
  esac
  eval "files_${key}=\"\$list $file\""
}

run_format_for_solution() {
  solution=$1
  key=$2
  eval "files=\$files_${key}"
  [ -n "$files" ] || return 0

  # Build --include args
  include_args=""
  for f in $files; do
    include_args="$include_args --include $f"
  done

  echo "Running dotnet format for ${solution#$repo_root/}"
  # shellcheck disable=SC2086
  dotnet format "$solution" --verify-no-changes $include_args
}

seed_bin_from_obj() {
  solution_dir=$(dirname "$1")
  # macOS 15 com.apple.provenance prevents .NET File.Copy from obj→bin;
  # shell cp works, so pre-seed bin with current obj outputs so the
  # incremental build skips the copy step entirely.
  find "$solution_dir" -path "*/obj/*/net*/*.dll" -o \
                       -path "*/obj/*/net*/*.exe" 2>/dev/null | while IFS= read -r src; do
    dest="${src/\/obj\//\/bin\/}"
    dest_dir=$(dirname "$dest")
    mkdir -p "$dest_dir"
    cp -f "$src" "$dest" 2>/dev/null || true
    touch "$dest" 2>/dev/null || true
  done
}

run_build_for_solution() {
  solution=$1
  echo "Running dotnet build for ${solution#$repo_root/}"
  seed_bin_from_obj "$solution"
  dotnet build "$solution"
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue

  base_sha=$remote_sha
  if [ "$remote_sha" = "$zero_sha" ]; then
    base_sha=$(first_push_base "$local_sha" "$(default_remote_ref)")
  fi

  for changed_file in $(git diff --name-only "$base_sha" "$local_sha" -- '*.cs'); do
    abs_file="$repo_root/$changed_file"
    case "$changed_file" in
      OnlineShopping/CartService/*)
        queue_solution "$solution_root/CartService/CartService.slnx"
        add_file_for_solution "CartService" "$abs_file"
        ;;
      OnlineShopping/CatalogService/*)
        queue_solution "$solution_root/CatalogService/CatalogService.slnx"
        add_file_for_solution "CatalogService" "$abs_file"
        ;;
      OnlineShopping/IdentityService/*)
        queue_solution "$solution_root/IdentityService/IdentityService.slnx"
        add_file_for_solution "IdentityService" "$abs_file"
        ;;
      OnlineShopping/Shared/ShoppingAuth/*)
        queue_solution "$solution_root/CartService/CartService.slnx"
        queue_solution "$solution_root/CatalogService/CatalogService.slnx"
        queue_solution "$solution_root/IdentityService/IdentityService.slnx"
        add_file_for_solution "CartService" "$abs_file"
        add_file_for_solution "CatalogService" "$abs_file"
        add_file_for_solution "IdentityService" "$abs_file"
        ;;
    esac
  done

  run_format_for_solution "$solution_root/CartService/CartService.slnx"   "CartService"
  run_format_for_solution "$solution_root/CatalogService/CatalogService.slnx" "CatalogService"
  run_format_for_solution "$solution_root/IdentityService/IdentityService.slnx" "IdentityService"

  for solution in $checked_solutions; do
    run_build_for_solution "$solution"
  done
done
